{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": ["node"],

    "rootDir": ".",
    "outDir": "./dist",

    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,

    "noEmitOnError": true,
    "skipLibCheck": true
  },

  "include": [
    "server/**/*.ts",
    "tests/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}