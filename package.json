{
  "name": "research-os",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent AI research memory, MCP server, and research dashboard.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:migrate": "tsx server/db/runMigrations.ts",
    "test:ingest": "tsx tests/test-ingest.ts",
    "test:existing": "tsx tests/test-existing-reference.ts",
    "test:search": "tsx tests/test-search.ts",
    "test:get": "tsx tests/test-get-entity.ts",
    "test:dashboard": "tsx tests/test-dashboard.ts",
    "test:queue:e001": "tsx tests/enqueue-e001-running.ts",
    "mcp:dev": "tsx server/index.ts",
    "sync:airtable": "tsx server/sync/airtableSync.ts",
    "sync:airtable:push": "tsx server/sync/airtableSync.ts",
    "sync:airtable:pull": "tsx server/sync/airtablePull.ts",
    "sync:airtable:watch": "tsx server/sync/syncLoop.ts",
    "dashboard:dev": "tsx server/dashboard/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TillyEndless/Research-OS.git"
  },
  "keywords": [
    "research",
    "mcp",
    "sqlite",
    "ai-research-assistant"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TillyEndless/Research-OS/issues"
  },
  "homepage": "https://github.com/TillyEndless/Research-OS#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
